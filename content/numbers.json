      "furigana": [{ "b": "ひゃく、せん、まん" }],
      "romaji": "hyaku, sen, man",
      "english": "100, 1,000, 10,000",
      "registerNotes": "Japanese groups in units of 10,000. ¥30,000 is 三万 (san-man), not 'thirty thousand'. Retraining this is the single hardest number habit.",
      "audio": "audio/ja/num-04.mp3",
      "audioHint": "ひゃく、せん、まん",
      "tags": ["numbers", "money", "essential"],
      "difficulty": 2
