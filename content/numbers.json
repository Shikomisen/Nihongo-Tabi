      "furigana": [{ "b": "よん、ご、ろく" }],
      "romaji": "yon, go, roku",
      "english": "4, 5, 6",
      "registerNotes": "4 is よん in most everyday counting; し exists but is avoided (it also means 'death').",
      "audio": "audio/ja/num-02.mp3",
      "audioHint": "よん、ご、ろく",
      "tags": ["numbers", "essential"],
      "difficulty": 1
    },
    {
